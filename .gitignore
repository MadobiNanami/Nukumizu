*.exe

# SQLite database files. They live on a network share (Y:), and git/cloud
# sync touching them while a WAL database is open corrupts the WAL index and
# crashes the process (EXCEPTION_IN_PAGE_ERROR). Never track these.
db/*.db
db/*.db-wal
db/*.db-shm
db/*.db-journal